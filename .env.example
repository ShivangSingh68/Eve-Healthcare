# Copy to .env and replace the placeholder secrets. Never commit .env.

# Local development (app running on your machine, Postgres from docker compose on :5432)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/eve_healthcare

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Shared with the payment provider; used to verify webhook HMAC signatures (min 16 chars)
WEBHOOK_SECRET=change-me-webhook-secret

# Chance (0..1) that the simulated POST /payments/ succeeds
PAYMENT_SUCCESS_RATE=0.8

LOG_LEVEL=INFO

# Optional: used by `python -m app.scripts.seed` to create an admin user
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password1

# docker compose database settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=eve_healthcare
